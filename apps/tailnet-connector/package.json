{
  "name": "@edgesh/tailnet-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@edgesh/contracts": "0.1.0",
    "ipaddr.js": "^2.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
