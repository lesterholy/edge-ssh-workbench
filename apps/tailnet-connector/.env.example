# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
CONNECTOR_HMAC_KEY=BASE64URL_32_BYTE_KEY
# Required. Literal IP targets are deliberately disabled.
TAILNET_ALLOWED_SUFFIX=example-tailnet.ts.net
TAILNET_ALLOWED_PORTS=22
LISTEN_HOST=127.0.0.1
PORT=8789
CONNECT_TIMEOUT_MS=10000
AUTH_WINDOW_SECONDS=30
MAX_CONNECTIONS=20
IDLE_TIMEOUT_MS=1800000
MAX_SESSION_MS=28800000
MAX_BUFFERED_BYTES=1048576
