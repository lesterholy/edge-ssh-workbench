{
  "name": "edge-ssh-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "apps/worker/shims/*"
  ],
  "scripts": {
    "secrets:init": "node scripts/init-secrets.mjs",
    "config:production": "node scripts/render-wrangler-config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .wrangler.production.toml",
    "dev:web": "npm run dev -w @edgesh/web",
    "dev:worker": "npm run dev -w @edgesh/worker",
    "dev:connector": "npm run dev -w @edgesh/tailnet-connector",
    "typecheck": "npm run typecheck -w @edgesh/contracts && npm run typecheck -w @edgesh/worker && npm run typecheck -w @edgesh/web && npm run typecheck -w @edgesh/tailnet-connector",
    "test": "vitest run",
    "build:web": "npm run build -w @edgesh/web",
    "build:connector": "npm run build -w @edgesh/tailnet-connector",
    "build": "npm run build:web && npm run build:connector",
    "check": "npm run typecheck && npm run test && npm run build && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "cpu-features": "0.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "smol-toml": "^1.7.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
